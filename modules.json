        "secondary_capabilities": [
          "configuration",
          "cryptography-and-secrets",
          "data-encoding",
          "transport-and-networking"
        ],
        "responsibility": "Load one bounded JSON configuration document from AWS Secrets Manager as an explicit sensitive configuration source.",
        "non_goals": [
          "Own AWS credential resolution, retries, IAM policy, secret creation, rotation, caching, or refresh scheduling.",
          "Perform global registration, mutate process environment, flatten dotenv input, or retain loaded secret plaintext."
        ],
