      "purpose": "`config` loads explicit, layered configuration sources into caller-owned Go structs. It provides deterministic precedence, strict decoding, immutable snapshots, safe provenance, validation orchestration, and redacted secrets without introducing global state or implicit filesystem discovery.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "foundations",
      "family_label": "Foundations",
      "family_description": "Common immutable values, deterministic seams, configuration, identity propagation, and input validation.",
      "family_order": 1,
      "cohesion": {
        "family": "foundations",
        "secondary_capabilities": [
          "configuration",
          "cryptography-and-secrets",
          "data-encoding",
          "http-and-service-edge",
          "protocols-and-schemas",
          "testing-and-conformance"
        ],
        "responsibility": "Load explicit, layered configuration sources into immutable typed snapshots with deterministic precedence, validation, safe provenance, and redacted secrets.",
        "non_goals": [
          "Provide global configuration state, implicit environment or filesystem discovery, runtime mutation, hot reload, secret management, or vendor credential ownership.",
          "Replace application-owned composition, deployment configuration delivery, or domain-specific validation policy."
        ],
        "public_package_identifier": "config",
        "primary_entry_packages": [
          "github.com/faustbrian/go-config"
        ],
        "package_selection": {
          "github.com/faustbrian/go-config": "Use for explicit startup configuration loading into immutable typed snapshots; use a settings package for runtime-mutable, versioned, persisted values."
